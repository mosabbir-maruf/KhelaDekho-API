# ==========================================
# KhelaDekho Backend & Worker Configuration
# ==========================================

# Cryptographic HMAC-SHA256 Signing Key (Required)
# Generate: openssl rand -hex 32
KHELADEKHO_SECRET_KEY=your-hmac-secret-key-here

# Upstream Scraper Target URLs
KHELADEKHO_TARGET_URL=https://example.com
KHELADEKHO_SPORTZFY_TARGET_URL=https://sportzfytvlive.xyz

# HMAC signature time window (seconds)
KHELADEKHO_SIGNATURE_WINDOW_SECONDS=60

# Cache Store (falls back to local memory if unset)
KHELADEKHO_REDIS_URL=redis://localhost:6379/0

# Cache TTLs (seconds)
KHELADEKHO_MATCH_CACHE_TTL=120
KHELADEKHO_CHANNEL_CACHE_TTL=120
KHELADEKHO_VOTE_CACHE_TTL=300

# Request settings
KHELADEKHO_REQUEST_TIMEOUT=30.0
KHELADEKHO_MAX_RETRIES=3
KHELADEKHO_RETRY_BACKOFF=2.0
KHELADEKHO_SCRAPE_INTERVAL_SECONDS=60

# Rate Limiter (requests per minute)
KHELADEKHO_RATE_LIMIT_RPM=30

# General Settings
KHELADEKHO_DEBUG=false
KHELADEKHO_LOG_LEVEL=INFO
