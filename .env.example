# ==========================================
# KhelaDekho API configuration
# ==========================================
# Shared by the FastAPI app and the Cloudflare Worker (set the same keys in
# wrangler.toml [vars] / the Cloudflare Dashboard).

# --- Authentication (single shared key across the whole project) ---
# Required by all API endpoints (header: xkey). Must match the frontend XKEY.
# Generate one: openssl rand -hex 32
XKEY=your-xkey-here

# --- Upstream base URLs (never hardcoded in source) ---
# V1 = score provider, V2/V4/V5 = channel providers. Set your own upstreams here.
V1_HOME_URL=https://your-v1-provider.example
V2_HOME_URL=https://your-v2-provider.example
V4_HOME_URL=https://your-v4-provider.example
V5_HOME_URL=https://your-v5-provider.example

# --- Kickbd decryption key (set to match upstream) ---
KICKBD_DECRYPT_KEY=999999859198

# --- Proxy configuration (Worker & Python) ---
# Comma-separated domain/URL patterns that need proxy routing (CDNs that check Referer)
PROXY_REQUIRED_PATTERNS=phantemlis.top,/papi/tv/playlist/
# Internal domain for Cache API key partitioning (Worker). Not used by Python backend.
CACHE_INTERNAL_DOMAIN=kheladekho-cache.internal

# --- Runtime ---
KHELADEKHO_DEBUG=false
KHELADEKHO_LOG_LEVEL=INFO
