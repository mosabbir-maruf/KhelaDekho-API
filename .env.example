# ==========================================
# KhelaDekho API configuration
# ==========================================
# Shared by the FastAPI app and the Cloudflare Worker (set the same keys in
# wrangler.toml [vars] / the Cloudflare Dashboard).

# --- Authentication (single shared key across the whole project) ---
# Required by all API endpoints (header: xkey). Must match the frontend XKEY.
# Generate one: openssl rand -hex 32
XKEY=your-xkey-here

# --- Upstream base URLs (never hardcoded in source) ---
# V1 = score provider, V2/V4 = channel providers. Set your own upstreams here.
V1_HOME_URL=https://your-v1-provider.example
V2_HOME_URL=https://your-v2-provider.example
V4_HOME_URL=https://your-v4-provider.example

# --- Runtime ---
KHELADEKHO_DEBUG=false
KHELADEKHO_LOG_LEVEL=INFO
